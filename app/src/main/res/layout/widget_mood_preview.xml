<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FF1B2421"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_neutral"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_preview_today_mood"
            android:textColor="#FF1F2B24"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_status"
        android:textColor="#FF52605B"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FF9FA8DA" />

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFC5CAE9" />

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFDCE5DF" />

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFFFECB3" />

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFDCE5DF" />

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FFC5CAE9" />

        <View
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="#FFFFECB3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_btn_secondary"
            android:gravity="center"
            android:text="@string/widget_action_add_moment"
            android:textColor="#FF1B2421"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_btn_primary"
            android:gravity="center"
            android:text="@string/widget_action_daily_summary"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
