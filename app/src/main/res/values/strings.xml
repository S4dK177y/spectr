    <!-- 7 symptoms labels & neutral criteria -->
    <string name="symptom_apathy_label">Апатия / нет радости</string>
    <string name="symptom_apathy_when">Заметная потеря интереса и удовольствия от привычных дел на протяжении большей части дня.</string>
    <string name="symptom_apathy_when_not">Обычная физическая усталость после тяжёлого дня, если интерес и радость сохраняются.</string>

    <string name="symptom_self_criticism_label">Самокритика / вина</string>
    <string name="symptom_self_criticism_when">Навязчивые самообвинения, чувство никчёмности или несоразмерная вина за мелочи.</string>
    <string name="symptom_self_criticism_when_not">Спокойный, конструктивный разбор конкретной ошибки без самоуничижения.</string>

    <string name="symptom_brain_fog_label">Туман / фокус</string>
    <string name="symptom_brain_fog_when">Трудно удерживать внимание, принимать простые решения, ощущение «ваты» или заторможенности в голове.</string>
    <string name="symptom_brain_fog_when_not">Кратковременная рассеянность из-за шумной обстановки или переключения между задачами.</string>

    <string name="symptom_binge_eating_label">Пищевой срыв</string>
    <string name="symptom_binge_eating_when">Эпизод выраженного переедания с ощущением потери контроля или заметного заедания эмоций.</string>
    <string name="symptom_binge_eating_when_not">Обычный плотный ужин, праздничный стол или плановая смена рациона без потери контроля.</string>

    <string name="symptom_death_thoughts_label">Мысли о смерти</string>
    <string name="symptom_death_thoughts_when">Любые мысли о желании исчезнуть, уснуть и не проснуться, бессмысленности жизни или самоповреждении.</string>
    <string name="symptom_death_thoughts_when_not">Отвлечённые философские размышления или новости без отношения к собственному состоянию. (Наличие галочки не требует автоматически ставить −5.)</string>

    <string name="symptom_hyperfocus_label">Гиперфикс / идеи</string>
    <string name="symptom_hyperfocus_when">Необычайно сильная захваченность проектом, потоком идей или планов, от которых трудно оторваться даже ради сна и еды.</string>
    <string name="symptom_hyperfocus_when_not">Спокойная продуктивная работа или увлечённость хобби, которую легко поставить на паузу.</string>

    <string name="symptom_racing_thoughts_label">Ускор. мысли</string>
    <string name="symptom_racing_thoughts_when">Ощущение скачки мыслей, когда идеи перескакивают быстрее обычного, сложно затормозить внутренний поток или речь.</string>
    <string name="symptom_racing_thoughts_when_not">Обычное волнение перед важным событием без ощущения неконтролируемого ускорения потока мыслей.</string>

